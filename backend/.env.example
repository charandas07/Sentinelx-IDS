# SentinelX Backend Environment Configuration
# Copy this file to .env and adjust values

DATABASE_URL=sqlite+aiosqlite:///./data/sentinelx.db
MAX_PCAP_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Authentication & Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-secure-password
DEBUG=false
LOG_LEVEL=INFO

# Detection Thresholds
PORT_SCAN_THRESHOLD=20
PORT_SCAN_WINDOW=10
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW=30
SYN_FLOOD_THRESHOLD=100
SYN_FLOOD_WINDOW=5
ICMP_FLOOD_THRESHOLD=50
ICMP_FLOOD_WINDOW=5
TRAFFIC_SPIKE_MULTIPLIER=3.0

# Capture / Demo Settings
# Set to true to generate synthetic traffic on startup (for demos/testing)
ENABLE_DEMO_ON_STARTUP=false
# Speed multiplier for guided demo scenario (higher = faster, e.g. 1.0 = real-time, 10.0 = test speed)
DEMO_SPEED=1.0

# Specific interface to capture on (must be set for live network monitoring, e.g. "eth0" or "Ethernet")
# Note for live capture:
# - On Windows: requires Npcap (in WinPcap API-compatible mode) and running in an Administrator shell.
# - On Linux: requires running as root or granting capabilities (sudo setcap cap_net_raw,cap_net_admin=eip <python_binary>).
CAPTURE_IFACE=

# BPF filter for live capture
CAPTURE_FILTER=ip

# Comma-separated local IPs (auto-detected if empty, e.g. "192.168.1.150,127.0.0.1")
LOCAL_IPS=

# Comma-separated protected subnets / CIDRs (treats traffic to these as inbound, e.g. "192.168.1.0/24,10.0.0.0/16")
PROTECTED_NETWORKS=

# Comma-separated IPs that should never trigger alerts
WHITELIST_IPS=

# Data Retention
# Delete TrafficFlow rows older than this many hours
RETENTION_HOURS=24

# Alert Notifications (Optional)
# Webhook URL to receive alert notifications via POST JSON payload
# ALERT_WEBHOOK_URL=https://webhook.site/your-webhook-id
